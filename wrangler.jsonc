{
  // Site statique N-CONSULT SOLUTIONS — Cloudflare Workers (static assets)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nconsultsolutions",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "nconsultsolutions.com", "custom_domain": true },
    { "pattern": "www.nconsultsolutions.com", "custom_domain": true }
  ]
}
